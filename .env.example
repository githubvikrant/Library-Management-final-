# Server Configuration
PORT=5000

# Frontend URL (e.g. for Render or local dev)
FRONTEND_URL=https://library-management-final-x5ae.onrender.com

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net
DB_NAME=library_management

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Brevo / SMTP Email Service (for forgot password)
BREVO_API_KEY=your_brevo_api_key_here
SMTP_MAIL=your_email@domain.com

# Cloudinary (for book/user image uploads)
CLOUDINARY_CLIENT_NAME=your_cloudinary_cloud_name
CLOUDINARY_CLIENT_API=your_cloudinary_api_key
CLOUDINARY_CLIENT_SECRET=your_cloudinary_api_secret

# Google OAuth (Optional: for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
